// Native Vulkan 1.3 Post-Process — Step 1: 256-bin Log2 Luminance Histogram (Auto-Exposure).
#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D hdr_scene;
layout(set = 0, binding = 1) uniform sampler linear_samp;

layout(set = 0, binding = 2, std430) buffer HistogramBuffer {
    uint bins[256];
} hist_buf;

layout(push_constant) uniform HistPush {
    uint width;
    uint height;
    float min_log_lum;
    float inv_log_lum_range;
    vec4 meter_rect; // xy = min_uv, zw = max_uv
    float scene_lum_scale;
    uint stride;
} pc;

shared uint s_bins[256];

void main() {
    const uint local_idx = gl_LocalInvocationIndex;
    s_bins[local_idx] = 0u;
    barrier();

    const uvec2 px = gl_GlobalInvocationID.xy * pc.stride;
    if (px.x < pc.width && px.y < pc.height) {
        const vec2 uv = (vec2(px) + 0.5 * float(pc.stride)) / vec2(float(pc.width), float(pc.height));
        if (uv.x >= pc.meter_rect.x && uv.x <= pc.meter_rect.z &&
            uv.y >= pc.meter_rect.y && uv.y <= pc.meter_rect.w) {
            const vec3 rgb = max(textureLod(sampler2D(hdr_scene, linear_samp), uv, 0.0).rgb, vec3(0.0)) *
                             pc.scene_lum_scale;
            const float luma = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
            uint bin = 0u;
            if (luma > 1e-5) {
                const float norm = clamp((log2(luma) - pc.min_log_lum) * pc.inv_log_lum_range, 0.0, 1.0);
                bin = clamp(uint(norm * 254.0 + 1.0), 1u, 255u);
            }
            atomicAdd(s_bins[bin], 1u);
        }
    }
    barrier();

    const uint count = s_bins[local_idx];
    if (count != 0u) {
        atomicAdd(hist_buf.bins[local_idx], count);
    }
}
