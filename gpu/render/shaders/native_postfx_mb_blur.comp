// Native Vulkan 1.3 Post-Process — Step 3: Full-Res 16-Tap Bilateral IGN Motion Blur.
// Features neighborhood max-velocity dilation (smooth weapon/cloak silhouette trails),
// soft-Z depth weighting (no background bleed over foreground hunter/pillars), and
// Interleaved Gradient Noise jittering (zero banding/comb artifacts on branches & weapons).
#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D hdr_scene;
layout(set = 0, binding = 1) uniform texture2D vel_map;
layout(set = 0, binding = 2) uniform sampler linear_samp;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D out_hdr_img;
layout(set = 0, binding = 4) uniform texture2D tile_max_tex;

layout(push_constant) uniform MbBlurPush {
    uint width;
    uint height;
    float inv_vel_w;
    float inv_vel_h;
    uint frame_index;
    uint flags; // bit0=cam_on, bit1=obj_on, bit2=debug_vis
} pc;

shared float s_tile_max[9];

float IgnNoise(vec2 px, uint frame_idx) {
    const vec2 p = px + vec2(float(frame_idx & 63u) * 5.588238, float(frame_idx & 63u) * 7.131917);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

void main() {
    // Phase 3 Step 3.2: Workgroup-uniform 3x3 tile max-velocity check (zero warp divergence!).
    // Each 16x16 full-res workgroup lies strictly inside one 32x32 tile (16x16 half-res mb_vel WG).
    const bool debug_vis = (pc.flags & 4u) != 0u;
    const uint tid = gl_LocalInvocationIndex;
    if (!debug_vis && tid < 9u) {
        const ivec2 tile_dim = textureSize(sampler2D(tile_max_tex, linear_samp), 0);
        const ivec2 base_tile = ivec2(gl_WorkGroupID.xy >> 1u);
        const int dx = int(tid % 3u) - 1;
        const int dy = int(tid / 3u) - 1;
        const ivec2 tc = clamp(base_tile + ivec2(dx, dy), ivec2(0), max(tile_dim - ivec2(1), ivec2(0)));
        s_tile_max[tid] = texelFetch(sampler2D(tile_max_tex, linear_samp), tc, 0).r;
    }
    barrier();

    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) {
        return;
    }

    const vec2 res = vec2(float(pc.width), float(pc.height));
    const vec2 uv = (vec2(px) + 0.5) / res;

    const vec3 center_rgb = max(textureLod(sampler2D(hdr_scene, linear_samp), uv, 0.0).rgb, vec3(0.0));

    float tile_max_v = 1e6;
    if (!debug_vis) {
        tile_max_v = max(max(s_tile_max[0], s_tile_max[1]), max(s_tile_max[2], s_tile_max[3]));
        tile_max_v = max(tile_max_v, max(max(s_tile_max[4], s_tile_max[5]), max(s_tile_max[6], s_tile_max[7])));
        tile_max_v = max(tile_max_v, s_tile_max[8]);
        // Entire 3x3 tile neighborhood has < 0.40 px motion: skip all vel_map reads & blur!
        if (tile_max_v < 0.40) {
            imageStore(out_hdr_img, ivec2(px), vec4(center_rgb, 1.0));
            return;
        }
    }

    const vec4 center_v = textureLod(sampler2D(vel_map, linear_samp), uv, 0.0);
    const vec2 v_center = center_v.xy;
    const float d_center = center_v.z;

    if (debug_vis) {
        // Live Velocity Debug View (Insert overlay checkbox):
        // - Dimmed scene base so silhouettes are recognizable
        // - Solid BLUE tint where velWrap.a > 0.5 (Pass 0x2e object mask: Hunter/weapon/enemies)
        // - Bright YELLOW/ORANGE on moving object pixels (proportional to obj_vel magnitude)
        // - RED/GREEN on moving camera/world pixels
        vec3 dbg = center_rgb * 0.22;
        const float px_mag = length(v_center * res);
        if (center_v.w > 0.5) {
            dbg += vec3(0.0, 0.08, 0.45);
            const float heat = clamp(px_mag / 12.0, 0.0, 1.0);
            dbg += vec3(heat * 2.5, heat * 2.0, 0.0);
        } else {
            dbg += vec3(abs(v_center.x) * 40.0, abs(v_center.y) * 40.0, 0.0);
        }
        imageStore(out_hdr_img, ivec2(px), vec4(dbg, 1.0));
        return;
    }

    // Neighborhood max-velocity dilation (~8 full-res px radius) for clean moving object trails.
    // Exact tile-bound fast path: tile_max_v bounds all velocities in the 3x3 32px tile neighborhood;
    // when tile_max_v <= center_px_len + 0.5 (typical camera panning), no neighbor can trigger the
    // dominant-velocity override below, skipping all extra vel_map fetches with identical output.
    const float center_px_len = length(v_center * res);
    vec2 v_dom = v_center;
    float d_dom = d_center;
    float obj_dom = center_v.w;
    if (tile_max_v > center_px_len + 0.5) {
        float max_len_sq = dot(v_center, v_center);
        const vec2 dilate_step = vec2(pc.inv_vel_w, pc.inv_vel_h) * 4.0;
        const vec2 kCross[4] = vec2[4](
            vec2(-1.0,  0.0), vec2(1.0, 0.0), vec2(0.0, -1.0), vec2(0.0, 1.0)
        );
        for (int k = 0; k < 4; ++k) {
            const vec4 n = textureLod(sampler2D(vel_map, linear_samp),
                                      clamp(uv + kCross[k] * dilate_step, 0.0, 1.0), 0.0);
            const float l2 = dot(n.xy, n.xy);
            if (l2 > max_len_sq) {
                max_len_sq = l2;
                v_dom = n.xy;
                d_dom = n.z;
                obj_dom = n.w;
            }
        }
    }

    // Fast early-out for static pixels (< 0.45 px motion): 0 extra texture fetches.
    const float dom_px_len = length(v_dom * res);
    if (dom_px_len < 0.45) {
        imageStore(out_hdr_img, ivec2(px), vec4(center_rgb, 1.0));
        return;
    }

    // Choose dominant velocity for moving object silhouettes, or center velocity for background
    // pixels that are closer than the moving background neighbor (prevents foreground halo).
    vec2 blur_vel = v_center;
    if (dom_px_len > center_px_len + 0.5) {
        // Accept dilated velocity if the fast neighbor is in front (or is a moving object).
        // Bloodborne depth is forward-Z (smaller d = closer to camera).
        if (obj_dom > 0.5 && (d_dom <= d_center + 0.0025)) {
            blur_vel = v_dom;
        } else if (d_dom <= d_center + 0.0008) {
            blur_vel = v_dom;
        }
    }

    const float blur_px_len = length(blur_vel * res);
    if (blur_px_len < 0.45) {
        imageStore(out_hdr_img, ivec2(px), vec4(center_rgb, 1.0));
        return;
    }

    // Adaptive symmetric IGN-jittered bilateral motion blur along [-0.5 .. +0.5] * blur_vel:
    // keeps tap spacing <= ~0.9 px (zero banding with IGN) while cutting texture bandwidth 40-60%
    // at 120-240+ FPS where FPS-normalized blur vectors are typically 2-6 pixels long.
    const float jitter = IgnNoise(vec2(px), pc.frame_index) - 0.5;
    const int kHalfTaps = (blur_px_len < 3.0) ? 2
                        : (blur_px_len < 7.0) ? 4
                        : (blur_px_len < 14.0) ? 6
                                               : 8;
    const float inv_taps = 1.0 / float(kHalfTaps);

    vec3 accum = center_rgb * 0.5;
    float w_sum = 0.5;

    for (int i = 0; i < kHalfTaps; ++i) {
        const float t = (float(i) + 0.5 + jitter) * inv_taps; // (0..1)
        const vec2 off = blur_vel * (0.5 * t);

        // Positive direction
        {
            const vec2 suv = clamp(uv + off, 0.0, 1.0);
            const vec4 sv = textureLod(sampler2D(vel_map, linear_samp), suv, 0.0);
            const vec3 sc = max(textureLod(sampler2D(hdr_scene, linear_samp), suv, 0.0).rgb, vec3(0.0));
            const float s_len = length(sv.xy * res);
            // Soft-Z foreground/background classification (forward-Z: smaller d = closer).
            const float fg = clamp((d_center - sv.z) * 400.0 + 1.0, 0.0, 1.0);
            const float bg = clamp((sv.z - d_center) * 400.0 + 1.0, 0.0, 1.0);
            const float sample_covers = clamp((s_len - t * blur_px_len) * 0.5 + 1.0, 0.0, 1.0);
            const float center_covers = clamp((center_px_len - t * blur_px_len) * 0.5 + 1.0, 0.0, 1.0);
            const float w = max(fg * sample_covers, bg * center_covers);
            accum += sc * w;
            w_sum += w;
        }
        // Negative direction
        {
            const vec2 suv = clamp(uv - off, 0.0, 1.0);
            const vec4 sv = textureLod(sampler2D(vel_map, linear_samp), suv, 0.0);
            const vec3 sc = max(textureLod(sampler2D(hdr_scene, linear_samp), suv, 0.0).rgb, vec3(0.0));
            const float s_len = length(sv.xy * res);
            const float fg = clamp((d_center - sv.z) * 400.0 + 1.0, 0.0, 1.0);
            const float bg = clamp((sv.z - d_center) * 400.0 + 1.0, 0.0, 1.0);
            const float sample_covers = clamp((s_len - t * blur_px_len) * 0.5 + 1.0, 0.0, 1.0);
            const float center_covers = clamp((center_px_len - t * blur_px_len) * 0.5 + 1.0, 0.0, 1.0);
            const float w = max(fg * sample_covers, bg * center_covers);
            accum += sc * w;
            w_sum += w;
        }
    }

    imageStore(out_hdr_img, ivec2(px), vec4(accum / max(w_sum, 1e-4), 1.0));
}
