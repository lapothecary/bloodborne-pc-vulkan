// Native Vulkan 1.3 Post-Process — Step 4: Half-Res 24-Tap Golden-Angle Vogel Disk Bokeh Gather.
// Resolution-independent circular HDR bokeh with near-field foreground bleed and strict
// far-field depth occlusion (background blur never leaks onto sharp foreground Hunter/NPCs).
#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D coc_tex;
layout(set = 0, binding = 1) uniform sampler linear_samp;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D out_bokeh_img;

layout(push_constant) uniform DofBokehPush {
    uint width;
    uint height;
    float inv_aspect;
    float max_coc_uv;
    uint frame_index;
    uint reserved;
} pc;

float IgnNoise(vec2 px, uint frame_idx) {
    const vec2 p = px + vec2(float(frame_idx & 63u) * 5.588238, float(frame_idx & 63u) * 7.131917);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

void main() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) {
        return;
    }

    const vec2 inv_res = 1.0 / vec2(float(pc.width), float(pc.height));
    const vec2 uv = (vec2(px) + 0.5) * inv_res;
    const vec4 center = textureLod(sampler2D(coc_tex, linear_samp), uv, 0.0);
    const float c_coc = center.a;

    // 3x3 neighborhood near-field CoC dilation so blurry foreground smoothly feathers over sharp bg.
    float min_near = min(c_coc, 0.0);
    const vec2 n_step = vec2(pc.max_coc_uv * 0.45 * pc.inv_aspect, pc.max_coc_uv * 0.45);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue;
            const vec2 nuv = clamp(uv + vec2(float(dx), float(dy)) * n_step, 0.0, 1.0);
            const float nc = textureLod(sampler2D(coc_tex, linear_samp), nuv, 0.0).a;
            min_near = min(min_near, nc);
        }
    }

    const float gather_r = max(abs(c_coc), -min_near);
    // Fast early-out for sharp in-focus / mid-ground pixels (< ~1.1 px @ 1440p): 0 bokeh taps.
    if (gather_r < 0.00075) {
        imageStore(out_bokeh_img, ivec2(px), vec4(center.rgb, 0.0));
        return;
    }

    // Adaptive Vogel-disk tap count: subtle midground blur uses 12-16 taps (silky smooth with IGN),
    // while strong far/near bokeh keeps the full 24-tap optical disk.
    const int kTaps = (gather_r < 0.0022) ? 12 : ((gather_r < 0.0045) ? 16 : 24);
    const float kGoldenAngle = 2.39996323;
    // Static spatial IGN (no frame_index rotation): since DoF runs AFTER DLSS/FSR/TAA,
    // per-frame angle rotation would flicker on static blurred backgrounds; spatial IGN
    // eliminates ring banding with zero temporal vibration.
    const float angle_off = IgnNoise(vec2(px), 0u) * 6.2831853;
    const float inv_taps = 1.0 / float(kTaps);

    vec3 far_accum = vec3(0.0);
    float far_w = 0.0;
    vec3 near_accum = vec3(0.0);
    float near_w = 0.0;

    // Anchor center pixel for far-field when pixel itself is blurred.
    if (c_coc > 0.0006) {
        far_accum = center.rgb * 0.65;
        far_w = 0.65;
    }

    for (int i = 0; i < kTaps; ++i) {
        const float r_norm = sqrt((float(i) + 0.5) * inv_taps);
        const float theta = float(i) * kGoldenAngle + angle_off;
        const float r_uv = r_norm * gather_r;
        const vec2 off = vec2(cos(theta) * pc.inv_aspect, sin(theta)) * r_uv;
        const vec2 suv = clamp(uv + off, 0.0, 1.0);
        const vec4 s = textureLod(sampler2D(coc_tex, linear_samp), suv, 0.0);
        const float s_coc = s.a;

        // Soft optical aperture profile: gentle center-weighting for normal surfaces to avoid
        // flat haze, while preserving full crisp circular disk energy on bright HDR highlights.
        const float s_luma = max(max(s.r, s.g), s.b);
        const float hdr_disk = clamp((s_luma - 1.2) * 0.5, 0.0, 1.0);
        const float aperture_w = mix(1.0 - 0.35 * r_norm * r_norm, 1.0, hdr_disk);

        // 1. Far-field gather: only accept samples whose CoC reaches this pixel AND are not in front
        //    of the center pixel (strictly prevents background halos leaking over sharp Hunter/trees).
        if (c_coc > 0.0006 && s_coc > 0.0005) {
            const float bg_guard = smoothstep(c_coc - 0.00055, c_coc + 0.00020, s_coc);
            const float disk_cov = smoothstep(r_uv - 0.00045, r_uv + 0.00045, s_coc);
            const float w = bg_guard * disk_cov * aperture_w;
            far_accum += s.rgb * w;
            far_w += w;
        }

        // 2. Near-field gather: blurry foreground samples bleed softly over sharp/far background.
        if (s_coc < -0.0005) {
            const float near_r = -s_coc;
            const float disk_cov = smoothstep(r_uv - 0.00055, r_uv + 0.00055, near_r);
            near_accum += s.rgb * (disk_cov * aperture_w);
            near_w += disk_cov * aperture_w;
        }
    }

    const vec3 far_rgb = (far_w > 1e-4) ? (far_accum / far_w) : center.rgb;
    const float near_alpha = clamp((near_w * inv_taps) * 2.2, 0.0, 1.0);
    const vec3 near_rgb = (near_w > 1e-4) ? (near_accum / near_w) : far_rgb;

    const vec3 out_rgb = mix(far_rgb, near_rgb, near_alpha);
    // Pack near-field bleed alpha in .a so full-res composite can blend blurry foreground smoothly
    // over sharp full-res background edges while keeping far-field governed by full-res depth CoC.
    imageStore(out_bokeh_img, ivec2(px), vec4(out_rgb, near_alpha));
}
