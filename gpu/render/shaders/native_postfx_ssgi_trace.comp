// Remaster v2: Half-Res L2-Resident 32-tap HBIL SSGI Compute Pass.
// Uses point texelFetch on packed (firefly-clamped radiance, 1.0 - depth) mip0/mip1 so
// foreground candle/pillar silhouettes never generate phantom bilinearly-interpolated depths,
// followed by a 3-pass edge-preserving A-Trous wavelet denoiser.
#version 460
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D rad_mip0_tex;
layout(set = 0, binding = 1) uniform texture2D rad_mip1_tex;
layout(set = 0, binding = 2) uniform sampler linear_samp;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D dst_ssgi_img;
layout(set = 0, binding = 4, std430) readonly buffer Ssbo2Buf {
    uint data[];
} ssbo_2;
layout(set = 0, binding = 5) uniform texture2D full_depth_tex;

layout(push_constant) uniform SsgiTracePush {
    uint dst_w;
    uint dst_h;
    uint d1_offset;
    float aspect;
} pc;

float s2f(uint idx) {
    return uintBitsToFloat(ssbo_2.data[idx]);
}

vec3 ReconstructPos(vec2 uv_s, float d_s, uint d1) {
    const vec2 n = vec2(uv_s.x * 2.0 - 1.0, 1.0 - uv_s.y * 2.0);
    const float cw = fma(s2f(d1 + 12u), n.x, fma(s2f(d1 + 13u), n.y, fma(s2f(d1 + 14u), d_s, s2f(d1 + 15u))));
    const float inv_w = 1.0 / cw;
    return vec3(
        fma(s2f(d1 + 0u), n.x, fma(s2f(d1 + 1u), n.y, fma(s2f(d1 + 2u), d_s, s2f(d1 + 3u)))) * inv_w,
        fma(s2f(d1 + 4u), n.x, fma(s2f(d1 + 5u), n.y, fma(s2f(d1 + 6u), d_s, s2f(d1 + 7u)))) * inv_w,
        fma(s2f(d1 + 8u), n.x, fma(s2f(d1 + 9u), n.y, fma(s2f(d1 + 10u), d_s, s2f(d1 + 11u)))) * inv_w
    );
}

void main() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.dst_w || px.y >= pc.dst_h) {
        return;
    }

    // Derive normalized UV from dst_ssgi_img dimensions and map into full_depth_tex via textureSize
    // so reduced upscaler proxies stay 100% aligned with native D32S8 depth.
    const vec2 uv_dst = (vec2(px) + 0.5) / max(vec2(pc.dst_w, pc.dst_h), vec2(1.0));
    const ivec2 full_sz = max(textureSize(full_depth_tex, 0), ivec2(1));
    const ivec2 full_max = full_sz - ivec2(1);
    const vec2 inv_full = 1.0 / vec2(full_sz);
    const ivec2 fp = clamp(ivec2(uv_dst * vec2(full_sz)), ivec2(0), full_max);
    const vec2 uv = (vec2(fp) + 0.5) * inv_full;
    const float depth = texelFetch(full_depth_tex, fp, 0).r;
    if (depth >= 0.99995) {
        imageStore(dst_ssgi_img, ivec2(px), vec4(0.0));
        return;
    }

    const uint d1 = pc.d1_offset;
    const vec3 P = ReconstructPos(uv, depth, d1);
    const float cam_dist = length(P);
    const float cam_fade = 1.0 - smoothstep(28.0, 48.0, cam_dist);
    if (cam_fade <= 0.001 || cam_dist <= 0.05) {
        imageStore(dst_ssgi_img, ivec2(px), vec4(0.0));
        return;
    }

    // Edge-preserving geometric normal from FP32 full-res depth neighbors (zero FP16 quantization).
    const ivec2 fpL = max(fp - ivec2(1, 0), ivec2(0));
    const ivec2 fpR = min(fp + ivec2(1, 0), full_max);
    const ivec2 fpU = max(fp - ivec2(0, 1), ivec2(0));
    const ivec2 fpD = min(fp + ivec2(0, 1), full_max);
    const float dL = texelFetch(full_depth_tex, fpL, 0).r;
    const float dR = texelFetch(full_depth_tex, fpR, 0).r;
    const float dU = texelFetch(full_depth_tex, fpU, 0).r;
    const float dD = texelFetch(full_depth_tex, fpD, 0).r;

    const vec3 dPdx = (abs(dR - depth) < abs(dL - depth))
                          ? (ReconstructPos((vec2(fpR) + 0.5) * inv_full, dR, d1) - P)
                          : (P - ReconstructPos((vec2(fpL) + 0.5) * inv_full, dL, d1));
    const vec3 dPdy = (abs(dD - depth) < abs(dU - depth))
                          ? (ReconstructPos((vec2(fpD) + 0.5) * inv_full, dD, d1) - P)
                          : (P - ReconstructPos((vec2(fpU) + 0.5) * inv_full, dU, d1));
    const vec3 N_raw = cross(dPdx, dPdy);
    const float N_len2 = dot(N_raw, N_raw);
    if (N_len2 <= 1e-12) {
        imageStore(dst_ssgi_img, ivec2(px), vec4(0.0));
        return;
    }

    vec3 N = N_raw * inversesqrt(N_len2);
    const vec3 V = -P / cam_dist;
    if (dot(N, V) < 0.0) {
        N = -N;
    }

    const ivec2 m0_sz = max(textureSize(rad_mip0_tex, 0), ivec2(1));
    const ivec2 m1_sz = max(textureSize(rad_mip1_tex, 0), ivec2(1));
    const ivec2 m0_max = m0_sz - ivec2(1);
    const ivec2 m1_max = m1_sz - ivec2(1);

    const float ign1 = fract(52.9829189 * fract(dot(vec2(px) + 0.5, vec2(0.06711056, 0.00583715))));
    const float ign2 = fract(52.9829189 * fract(dot(vec2(px) + vec2(17.3, 31.7), vec2(0.06711056, 0.00583715))));
    const float max_uv_r = clamp(0.75 / max(cam_dist, 2.2), 0.055, 0.28);

    vec3 gi_acc = vec3(0.0);
    float occ_acc = 0.0;

    // 4 orthogonal IGN-rotated horizon sectors x 8 stratified steps using point texelFetch
    // (eliminates phantom mid-air depths caused by bilinear filtering across silhouettes).
    for (uint dir_idx = 0u; dir_idx < 4u; ++dir_idx) {
        const float ang = (float(dir_idx) + ign1) * 1.57079633;
        const vec2 ray_uv = vec2(cos(ang) / pc.aspect, sin(ang));
        const float dir_jitter = fract(ign2 + float(dir_idx) * 0.38196601);
        float max_sin_h = 0.16;
        for (uint s = 0u; s < 8u; ++s) {
            const float step_j = fract(dir_jitter + float(s) * 0.61803399);
            const float t_lin = max((float(s) + step_j) * (1.0 / 8.0), 0.03);
            const float t_rad = t_lin * (0.22 + 0.78 * t_lin);
            const vec2 uv_s = uv + ray_uv * (max_uv_r * t_rad);
            if (uv_s.x <= 0.002 || uv_s.x >= 0.998 || uv_s.y <= 0.002 || uv_s.y >= 0.998) {
                break;
            }
            const float edge_x = smoothstep(0.0, 0.05, min(uv_s.x, 1.0 - uv_s.x));
            const float edge_y = smoothstep(0.0, 0.05, min(uv_s.y, 1.0 - uv_s.y));
            const float edge_w = edge_x * edge_y;

            vec4 tap;
            vec2 tap_uv;
            if (s < 3u) {
                const ivec2 tp = clamp(ivec2(uv_s * vec2(m0_sz)), ivec2(0), m0_max);
                tap = texelFetch(rad_mip0_tex, tp, 0);
                tap_uv = (vec2(tp) + 0.5) / vec2(m0_sz);
            } else {
                const ivec2 tp = clamp(ivec2(uv_s * vec2(m1_sz)), ivec2(0), m1_max);
                tap = texelFetch(rad_mip1_tex, tp, 0);
                tap_uv = (vec2(tp) + 0.5) / vec2(m1_sz);
            }

            const float inv_d_s = tap.a;
            if (inv_d_s <= 5e-5) {
                const vec3 P_sky = ReconstructPos(tap_uv, 0.9999, d1);
                const float sky_len2 = dot(P_sky, P_sky);
                if (sky_len2 > 1e-6) {
                    const float sin_h = dot(N, P_sky * inversesqrt(sky_len2));
                    if (sin_h > max_sin_h) {
                        const float dw = sin_h * sin_h - max_sin_h * max_sin_h;
                        max_sin_h = sin_h;
                        vec3 L_sky = max(tap.rgb, vec3(0.0));
                        const float l_sky = dot(L_sky, vec3(0.2126, 0.7152, 0.0722));
                        L_sky = max(mix(vec3(l_sky), L_sky, 1.12), vec3(0.0)) / (1.0 + l_sky * 0.45);
                        gi_acc += L_sky * (dw * 0.48 * edge_w);
                    }
                }
            } else {
                const float d_s = 1.0 - inv_d_s;
                const vec3 P_s = ReconstructPos(tap_uv, d_s, d1);
                const vec3 diff = P_s - P;
                const float dist2 = dot(diff, diff);
                if (dist2 > 0.004 && dist2 < 64.0) {
                    const float dist = sqrt(dist2);
                    const float sin_h = dot(N, diff / dist);
                    if (sin_h > max_sin_h) {
                        const float dw = sin_h * sin_h - max_sin_h * max_sin_h;
                        max_sin_h = sin_h;
                        // Smooth near/far attenuation keeps bounce physically grounded without
                        // hard rings or bright halos from thin foreground objects (candles/pillars).
                        const float near_fade = smoothstep(0.24, 0.80, dist);
                        const float range_fade = 1.0 - smoothstep(4.5, 8.0, dist);
                        const float atten = (near_fade * range_fade) / (1.0 + dist2 * 0.24);
                        vec3 L_s = max(tap.rgb, vec3(0.0));
                        const float l_s = dot(L_s, vec3(0.2126, 0.7152, 0.0722));
                        L_s = max(mix(vec3(l_s), L_s, 1.12), vec3(0.0)) / (1.0 + l_s * 0.45);
                        gi_acc += L_s * (dw * atten * edge_w);
                    }
                }
            }
        }
        occ_acc += clamp((max_sin_h - 0.16) * 1.10, 0.0, 1.0);
    }

    const vec3 gi_out = gi_acc * (4.8 / 4.0) * cam_fade;
    const float occ_out = (occ_acc * 0.25) * cam_fade;
    imageStore(dst_ssgi_img, ivec2(px), vec4(max(gi_out, vec3(0.0)), clamp(occ_out, 0.0, 1.0)));
}
