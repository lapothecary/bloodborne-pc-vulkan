// Phase 2.3: Native Vulkan 1.3 GLSL 460 replacement for cs 0x000000009a9cf8a9
// (Yebis 2 8x8x1 2D UAV Image Clear — fallback when HLE fast-clear is bypassed).
#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(constant_id = 0) const uint SWZ_MODE = 0u;

layout(push_constant) uniform AuxData {
    float xoffset;
    float yoffset;
    float xscale;
    float yscale;
    uvec4 ud_regs0;
    uvec4 ud_regs1;
    uvec4 ud_regs2;
    uvec4 ud_regs3;
    uvec4 buf_offsets0;
    uvec4 buf_offsets1;
    uvec2 buf_offsets2;
    uint motion_param;
    uint scene_size;
} push_data;

layout(set = 0, binding = 0, std430) readonly buffer ssbo_1_buf { uint data[]; } ssbo_1;
layout(set = 0, binding = 1) writeonly uniform image2D cs_img0;

void main() {
    const uint d0 = (push_data.buf_offsets0.x & 0xFFu) >> 2u;
    const vec4 raw_c = vec4(uintBitsToFloat(ssbo_1.data[d0 + 0u]),
                            uintBitsToFloat(ssbo_1.data[d0 + 1u]),
                            uintBitsToFloat(ssbo_1.data[d0 + 2u]),
                            uintBitsToFloat(ssbo_1.data[d0 + 3u]));
    vec4 out_c;
    if (SWZ_MODE == 1u) {
        out_c = raw_c.bgra;
    } else if (SWZ_MODE == 2u) {
        out_c = vec4(raw_c.rgb, 0.0);
    } else {
        out_c = raw_c;
    }
    imageStore(cs_img0, ivec2(gl_GlobalInvocationID.xy), out_c);
}
